# ============================================
# PRODUCTION ENVIRONMENT VARIABLES (EXAMPLE)
# ============================================

# Server Configuration
PORT=3000
NODE_ENV=production

# MongoDB (Use Atlas or managed MongoDB)
MONGO_URI=your_mongodb_connection_string

# JWT Authentication
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=7d

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
CORS_ORIGIN=https://your-frontend-domain.com
SECURE_COOKIES=true
HTTPS_ONLY=true

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# API Timeout (in milliseconds)
API_TIMEOUT=30000

# ============================================
# EXTERNAL API KEYS (CONFIGURE AS NEEDED)
# ============================================

# AI Image Generation (Choose one)
# Option 1: Replicate API
# REPLICATE_API_KEY=your_replicate_api_key

# Option 2: OpenAI DALL-E
# OPENAI_API_KEY=your_openai_api_key

# Option 3: Stability AI
STABILITY_AI_KEY=your_stability_ai_key

# Email Service (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email_address
SMTP_PASSWORD=your_email_app_password
SMTP_FROM_EMAIL=your_email_address

# Payment Gateway (if using subscription)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Optional: Sentry for Error Tracking
SENTRY_DSN=your_sentry_dsn

# Optional: Cloudwatch/Monitoring
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
